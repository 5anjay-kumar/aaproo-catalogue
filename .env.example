# ─── Aaproo Catalogue — environment variables ────────────────────────────────
# Copy this file to `.env.local` for local dev, and set the same variables in
# your host's dashboard (e.g. Vercel → Project → Settings → Environment Variables)
# for production. NEVER commit real values — `.env*` is gitignored.
#
# If you leave ORDERMS_API_BASE_URL empty, the app runs on built-in DEMO data so
# it's fully usable before Airtable is connected.

# ── Required for live Airtable data ──────────────────────────────────────────
# ORDERMS_API_BASE_URL=https://api.airtable.com/v0/<MY_BASE_ID>
# ORDERMS_API_KEY=<MY_AIRTABLE_PAT>

# ── Airtable-specific overrides ───────────────────────────────────────────────
# Table name, appended to the base URL (Airtable paginates 100 records/page;
# the app follows the "offset" it returns automatically):
# ORDERMS_PRODUCTS_PATH=/Products

# Airtable attachment URLs are served from a varying *.airtableusercontent.com
# subdomain — the image proxy already allows any subdomain of it. This is only
# needed if you use a custom CDN / different attachment host.
# ORDERMS_IMAGE_HOSTS=v5.airtableusercontent.com

# How the API key is sent. Default sends: Authorization: Bearer <key>, which is
# what Airtable expects — no change needed.
# ORDERMS_API_KEY_HEADER=Authorization
# ORDERMS_API_KEY_PREFIX=Bearer

# Server-side cache lifetime for Airtable responses, in seconds (default 300).
# ORDERMS_CACHE_SECONDS=300

# Server-side cache lifetime for fetched image bytes, in seconds (default 86400 = 1 day).
# Longer than ORDERMS_CACHE_SECONDS since photos change far less often than price/stock.
# ORDERMS_IMAGE_CACHE_SECONDS=86400

# ── Analytics ──────────────────────────────────────────────────────────────
# Mixpanel project token (client-embedded, not a secret). Leave empty to run
# with analytics disabled — the app works fine either way.
# NEXT_PUBLIC_MIXPANEL_TOKEN=<your-mixpanel-project-token>
